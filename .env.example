# Postgres (Neon, pooled — hostname must contain -pooler). Empty locally: the JSON store is used.
DATABASE_URL=
# HMAC key for session cookies.
MILEGI_SESSION_SECRET=dev-only-change-me
# Override the local JSON store path. Leave empty to use the OS temp dir.
MILEGI_STORE_PATH=
# Deliberate opt-out that allows a Vercel deploy with no database (smoke deploys only).
MILEGI_ALLOW_EPHEMERAL=
